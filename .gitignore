# OpenClaw - Prevent workspace leakage
.openclaw/
*.openclaw.*

# Environment & Secrets
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
credentials.json
secrets.json

# Dependencies
node_modules/

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo
playwright-report/
test-results/

# Supplied copies held outside static export pending review; preserve locally.
artifacts/jonah-image-review/publication-hold/
# Local composition screenshots include rights-unresolved reproductions; never publish.
artifacts/jonah-v1-review/
# Unidentified digital reproductions: do not redistribute without rights evidence.
artifacts/jonah-image-review/met-vaillant-prophet-jonas.jpg
artifacts/jonah-image-review/cma-jonah-swallowed.jpeg
artifacts/jonah-image-review/cma-jonah-cast-up.jpg
# Commons public-domain labels not reconfirmed with the institution. Local visual review only; do not publish the files.
artifacts/jonah-visual-review/*.jpg

