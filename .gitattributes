# Keep copied public text and all build inputs identical across Git checkouts.
# Binary detection remains automatic; pinned publisher snapshots below retain
# their original mixed line endings.
* text=auto eol=lf

# Pinned publisher HTML contains mixed line endings: preserve exact source bytes.
# JSON and generated checksum manifests retain LF across checkouts.
src/content/scripture/web-jonah-*.html -text
src/content/scripture/web-rights.html -text
src/content/scripture/web-jonah-*.json text eol=lf
src/content/scripture/james-web-*.html -text
src/content/scripture/james-quotes.json text eol=lf
# Retained publisher bytes include their original blank-line spacing and CRLF.
src/content/lachish/scripture/*.html -text whitespace=-blank-at-eol,cr-at-eol
artifacts/jonah-image-review/SHA256SUMS text eol=lf
